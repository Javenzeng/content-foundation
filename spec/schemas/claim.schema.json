{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Content Foundation Claim",
  "type": "object",
  "required": ["claim_id", "statement", "claim_type", "scope", "source_ids", "status"],
  "properties": {
    "claim_id": {"type": "string", "pattern": "^CLM-[A-Z0-9-]+$"},
    "statement": {"type": "string", "minLength": 1},
    "claim_type": {"type": "string", "enum": ["fact", "interpretation", "requirement", "copy"]},
    "scope": {"type": "string", "minLength": 1},
    "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "status": {"type": "string", "enum": ["candidate", "verified", "rejected"]}
  },
  "additionalProperties": false
}

